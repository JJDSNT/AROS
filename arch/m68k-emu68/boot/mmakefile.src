include $(SRCDIR)/config/aros.cfg

TARGETDIR := $(GENDIR)/$(CURDIR)
BOOTOBJ   := $(TARGETDIR)/entry.o $(TARGETDIR)/usermode.o $(TARGETDIR)/boot.o \
             $(TARGETDIR)/console.o $(TARGETDIR)/selftest.o \
             $(TARGETDIR)/font8x14.o
BOOTELF   := $(AROSDIR)/aros-emu68-m68k.elf
BOOTMAP   := $(GENDIR)/boot/aros-emu68-m68k.elf.map
COREPUBLIC := $(KOBJSDIR)/kernel_resource.o $(KOBJSDIR)/exec_library.o
CORERESIDENTS := timer_device utility_library oop_library hiddclass_hidd \
                 bootloader_resource gfx_hidd graphics_library layers_library \
                 keymap_library inputclass_hidd keyboard_hidd mouse_hidd \
                 keyboard_device gameport_device input_device
CORELOCAL := $(addprefix $(KOBJSDIR)/,$(addsuffix .emu68.ko,$(CORERESIDENTS)))
COREOBJS  := $(COREPUBLIC) $(CORELOCAL)
CORELIBS  := -L$(AROS_LIB) -larossupport -lautoinit -llibinit -lamiga \
             -lstdc.static -lgcc

USER_CPPFLAGS := -D__EMU68__
USER_CFLAGS   := $(CFLAGS_NO_BUILTIN) -fno-common
USER_INCLUDES := -I$(SRCDIR)/rom/kernel -I$(SRCDIR)/rom/exec

#MM- kernel-link-emu68-m68k : kernel-kernel-kobj kernel-exec-kobj kernel-timer-kobj kernel-utility-kobj kernel-oop-kobj kernel-hidd-kobj kernel-bootloader-kobj kernel-hidd-gfx-kobj kernel-graphics-kobj kernel-layers-kobj kernel-keymap-kobj kernel-hidd-input-kobj kernel-hidd-kbd-kobj kernel-hidd-mouse-kobj kernel-keyboard-kobj kernel-gameport-kobj kernel-input-kobj
#MM- kernel-link-emu68-m68k-quick : kernel-kernel-kobj-quick kernel-exec-kobj-quick kernel-timer-kobj-quick kernel-utility-kobj-quick kernel-oop-kobj-quick kernel-hidd-kobj-quick kernel-bootloader-kobj-quick kernel-hidd-gfx-kobj-quick kernel-graphics-kobj-quick kernel-layers-kobj-quick kernel-keymap-kobj-quick kernel-hidd-input-kobj-quick kernel-hidd-kbd-kobj-quick kernel-hidd-mouse-kobj-quick kernel-keyboard-kobj-quick kernel-gameport-kobj-quick kernel-input-kobj-quick
#MM kernel-link-emu68-m68k: $(BOOTELF)
#MM kernel-link-emu68-m68k-quick: $(BOOTELF)
kernel-link-emu68-m68k: $(BOOTELF)
kernel-link-emu68-m68k-quick: $(BOOTELF)

$(BOOTELF): $(BOOTOBJ) $(COREOBJS) $(SRCDIR)/$(CURDIR)/emu68.ld
	@$(MKDIR) $(AROSDIR) $(GENDIR)/boot
	@$(ECHO) "Linking $@"
	$(Q)$(KERNEL_CC) -nostdlib -nostartfiles -static \
		-Wl,-r -Wl,-Map=$(BOOTMAP) \
		-Wl,--defsym,SysBase=0x4 \
		-Wl,--defsym,AbsExecBase=0x4 \
		-Wl,-T,$(SRCDIR)/$(CURDIR)/emu68.ld \
		-o $@ $(BOOTOBJ) $(COREOBJS) $(CORELIBS)
	$(Q)$(TARGET_STRIP) $(TARGET_STRIP_FLAGS) $@

$(KOBJSDIR)/%.emu68.ko: $(KOBJSDIR)/%.o
	$(Q)$(NM_PLAIN) --defined-only $< | cut -d' ' -f3 >$@.sym
	$(Q)$(OBJCOPY) --localize-symbols $@.sym $< $@

$(TARGETDIR)/%.o: %.S
	@$(MKDIR) $(@D)
	%compile_q cmd="$(KERNEL_CC)" opt="$(strip $(AFLAGS) $(TARGET_CFLAGS) $(CPPFLAGS))"

$(TARGETDIR)/%.o: %.c
	@$(MKDIR) $(@D)
	%compile_q cmd="$(KERNEL_CC)" opt="$(strip $(CFLAGS) $(CPPFLAGS))"

$(TARGETDIR)/font8x14.o: $(SRCDIR)/arch/all-native/bootconsole/font8x14.c
	@$(MKDIR) $(@D)
	%compile_q cmd="$(KERNEL_CC)" opt="$(strip $(CFLAGS) $(CPPFLAGS))"

#MM
clean ::
	-$(RM) $(BOOTELF) $(BOOTMAP) $(BOOTOBJ) $(CORELOCAL) \
	    $(addsuffix .sym,$(CORELOCAL))
