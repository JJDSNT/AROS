include $(SRCDIR)/config/aros.cfg

TARGETDIR := $(GENDIR)/$(CURDIR)
BOOTOBJ   := $(TARGETDIR)/entry.o $(TARGETDIR)/usermode.o $(TARGETDIR)/boot.o \
             $(TARGETDIR)/console.o $(TARGETDIR)/selftest.o \
             $(TARGETDIR)/diag.o $(TARGETDIR)/romboot.o
BOOTELF   := $(AROSDIR)/aros-emu68-m68k.elf
BOOTMAP   := $(GENDIR)/boot/aros-emu68-m68k.elf.map
COREPUBLIC := $(KOBJSDIR)/kernel_resource.o $(KOBJSDIR)/exec_library.o
#
# Link order is ROMTag scan order, and that matters: krnRomTagScanner() jumps
# to each ROMTag's rt_EndSkip, and dosboot's points at its own second ROMTag
# ("DOSBoot cleanup", from `addromtag db_Cleanup`) which the linker places far
# into .rodata -- a span of roughly 70KB. Any module linked after dosboot has
# its ROMTag silently skipped and never initialises. dosboot_resource stays
# last; new modules go in ahead of it.
#
CORERESIDENTS := timer_device utility_library oop_library hiddclass_hidd \
                 bootloader_resource gfx_hidd emu68gfx_hidd graphics_library \
                 layers_library keymap_library inputclass_hidd keyboard_hidd \
                 mouse_hidd keyboard_device gameport_device input_device \
                 intuition_library expansion_library partition_library \
                 FileSystem_resource fat_handler \
                 dos_library dosboot_resource

#
# Deliberately NOT linked, though still built (see the #MM- lines below):
#
#   mbox_resource   -- soc/mbox
#   sdcard_device   -- soc/sdcard, the Arasan backend
#
# Emu68's expansion ROM carries brcm-sdhc.device and mailbox.resource, which
# drive the very same Arasan controller and VideoCore mailbox. Nothing stops
# both sides initialising: the names differ, so no DeviceList clash warns us,
# and both would end up programming the same registers and both calling
# KrnAddIRQHandler(62). Exactly one side has to own each piece of hardware.
#
# Ours are kept in the tree and one line away. soc/sdcard is still the only
# path to DMA -- Emu68's device does not do it, and neither does our Arasan
# backend yet, but its SDHOST sibling in arch/arm-native does.
#
CORELOCAL := $(addprefix $(KOBJSDIR)/,$(addsuffix .emu68.ko,$(CORERESIDENTS)))
COREOBJS  := $(COREPUBLIC) $(CORELOCAL)
CORELIBS  := -L$(AROS_LIB) -larossupport -lautoinit -llibinit -lamiga \
             -lstdc.static -lgcc

USER_CPPFLAGS := -D__EMU68__ -DADATE="\"$(shell date "+%d.%m.%Y")\""
USER_CFLAGS   := $(CFLAGS_NO_BUILTIN) -fno-common
USER_INCLUDES := -I$(SRCDIR)/rom/kernel -I$(SRCDIR)/rom/exec \
    -I$(SRCDIR)/arch/m68k-emu68/platform

#MM- kernel-link-emu68-m68k : kernel-kernel-kobj kernel-exec-kobj kernel-timer-kobj kernel-utility-kobj kernel-oop-kobj kernel-hidd-kobj kernel-bootloader-kobj kernel-hidd-gfx-kobj kernel-m68k-emu68-emu68gfx-kobj kernel-graphics-kobj kernel-layers-kobj kernel-keymap-kobj kernel-hidd-input-kobj kernel-hidd-kbd-kobj kernel-hidd-mouse-kobj kernel-keyboard-kobj kernel-gameport-kobj kernel-input-kobj kernel-intuition-kobj kernel-expansion-kobj kernel-partition-kobj kernel-mbox-emu68-kobj kernel-sdcard-kobj kernel-filesystem-kobj kernel-fs-fat-kobj kernel-dos-kobj kernel-dosboot-kobj
#MM- kernel-link-emu68-m68k-quick : kernel-kernel-kobj-quick kernel-exec-kobj-quick kernel-timer-kobj-quick kernel-utility-kobj-quick kernel-oop-kobj-quick kernel-hidd-kobj-quick kernel-bootloader-kobj-quick kernel-hidd-gfx-kobj-quick kernel-m68k-emu68-emu68gfx-kobj-quick kernel-graphics-kobj-quick kernel-layers-kobj-quick kernel-keymap-kobj-quick kernel-hidd-input-kobj-quick kernel-hidd-kbd-kobj-quick kernel-hidd-mouse-kobj-quick kernel-keyboard-kobj-quick kernel-gameport-kobj-quick kernel-input-kobj-quick kernel-intuition-kobj-quick kernel-expansion-kobj-quick kernel-partition-kobj-quick kernel-mbox-emu68-kobj-quick kernel-sdcard-kobj-quick kernel-filesystem-kobj-quick kernel-fs-fat-kobj-quick kernel-dos-kobj-quick kernel-dosboot-kobj-quick
#MM kernel-link-emu68-m68k: $(BOOTELF)
#MM kernel-link-emu68-m68k-quick: $(BOOTELF)
kernel-link-emu68-m68k: $(BOOTELF)
kernel-link-emu68-m68k-quick: $(BOOTELF)

$(BOOTELF): $(BOOTOBJ) $(COREOBJS) $(SRCDIR)/$(CURDIR)/emu68.ld
	@$(MKDIR) $(AROSDIR) $(GENDIR)/boot
	@$(ECHO) "Linking $@"
	$(Q)$(KERNEL_CC) -nostdlib -nostartfiles -static \
		-Wl,-r -Wl,-Map=$(BOOTMAP) \
		-Wl,--defsym,SysBase=0x4 \
		-Wl,--defsym,AbsExecBase=0x4 \
		-Wl,-T,$(SRCDIR)/$(CURDIR)/emu68.ld \
		-o $@ $(BOOTOBJ) $(COREOBJS) $(CORELIBS)
	$(Q)$(TARGET_STRIP) $(TARGET_STRIP_FLAGS) $@

$(KOBJSDIR)/%.emu68.ko: $(KOBJSDIR)/%.o
	$(Q)$(NM_PLAIN) --defined-only $< | cut -d' ' -f3 >$@.sym
	$(Q)$(OBJCOPY) --localize-symbols $@.sym $< $@

$(TARGETDIR)/%.o: %.S
	@$(MKDIR) $(@D)
	%compile_q cmd="$(KERNEL_CC)" opt="$(strip $(AFLAGS) $(TARGET_CFLAGS) $(CPPFLAGS))"

$(TARGETDIR)/%.o: %.c
	@$(MKDIR) $(@D)
	%compile_q cmd="$(KERNEL_CC)" opt="$(strip $(CFLAGS) $(CPPFLAGS))"

#MM
clean ::
	-$(RM) $(BOOTELF) $(BOOTMAP) $(BOOTOBJ) $(CORELOCAL) \
	    $(addsuffix .sym,$(CORELOCAL))
